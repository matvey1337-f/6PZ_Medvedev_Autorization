<Page x:Class="_2_wpf_medvedev_.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2_wpf_medvedev_.Pages"
      mc:Ignorable="d" 
      Title="Autho" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin" Width="200"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword" Width="200"/>

            <TextBlock x:Name="tblCaptcha" Text="Капча:" Visibility="Collapsed"/>
            <TextBox x:Name="tbCaptcha" Width="200" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="80" Margin="0,15,0,0">
                <Button x:Name="btnEnterGuests" Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Content="Войти" Click="btnEnter_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>